<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
	<BaseOutputPath>..\..\build</BaseOutputPath>
	<PublishSingleFile>true</PublishSingleFile>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<WarningLevel>9999</WarningLevel>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\G2DataGUI.Common\G2DataGUI.Common.csproj" />
    <ProjectReference Include="..\G2DataGUI.Contexts\G2DataGUI.Contexts.csproj" />
    <ProjectReference Include="..\G2DataGUI.Services\G2DataGUI.Services.csproj" />
    <!-- ItemViewModel/CollectionViewModel and BaseViewModel live here. -->
    <ProjectReference Include="..\G2DataGUI.UI.Common\G2DataGUI.UI.Common.csproj" />
    <!-- Domain/Repositories are already pulled in transitively via Contexts
         and UI.Common, but ViewModels/ names them directly (e.g.
         MoveRepository, Move), so they're listed explicitly here too. -->
    <ProjectReference Include="..\G2DataGUI.Domain\G2DataGUI.Domain.csproj" />
    <ProjectReference Include="..\G2DataGUI.Repositories\G2DataGUI.Repositories.csproj" />
  </ItemGroup>
</Project>
