<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<Color x:Key="SystemAccentColor">#FF6C5CE7</Color>
			<Color x:Key="SystemAccentColorDark1">#FF5847C9</Color>
			<Color x:Key="SystemAccentColorDark2">#FF4536A8</Color>
			<Color x:Key="SystemAccentColorDark3">#FF322686</Color>
			<Color x:Key="SystemAccentColorLight1">#FF8676ED</Color>
			<Color x:Key="SystemAccentColorLight2">#FFA192F2</Color>
			<Color x:Key="SystemAccentColorLight3">#FFBCB0F7</Color>

			<Color x:Key="AppBackgroundColor">#FFF7F8FA</Color>
			<Color x:Key="AppContentBackgroundColor">#FFFFFFFF</Color>
			<Color x:Key="AppPanelBackgroundColor">#FFEDEFF2</Color>
			<Color x:Key="AppControlBorderColor">#FFDDE1E6</Color>
			<Color x:Key="AppForegroundColor">#FF16181D</Color>
			<Color x:Key="AppSecondaryTextColor">#8C16181D</Color>
			<Color x:Key="AppHoverBrushColor">#FF8676ED</Color>

			<Color x:Key="AppSelectionColor">#FF4536A8</Color>
			<Color x:Key="AppDirtyIndicatorColor">#FF6C5CE7</Color>
			<Color x:Key="AppErrorColor">#FFDC2626</Color>
			<Color x:Key="AppWarningColor">#FFD97706</Color>
			<Color x:Key="AppSuccessColor">#FF059669</Color>
		</ResourceDictionary>

		<ResourceDictionary x:Key="Dark">
			<Color x:Key="SystemAccentColor">#FF7C6DF0</Color>
			<Color x:Key="SystemAccentColorDark1">#FF6C5CE7</Color>
			<Color x:Key="SystemAccentColorDark2">#FF5847C9</Color>
			<Color x:Key="SystemAccentColorDark3">#FF4536A8</Color>
			<Color x:Key="SystemAccentColorLight1">#FF9384F2</Color>
			<Color x:Key="SystemAccentColorLight2">#FFAB9EF5</Color>
			<Color x:Key="SystemAccentColorLight3">#FFC3B9F8</Color>

			<Color x:Key="AppBackgroundColor">#FF0F1115</Color>
			<Color x:Key="AppContentBackgroundColor">#FF16181D</Color>
			<Color x:Key="AppPanelBackgroundColor">#FF1B1E24</Color>
			<Color x:Key="AppControlBorderColor">#FF2A2E37</Color>
			<Color x:Key="AppForegroundColor">#FFE8EAED</Color>
			<Color x:Key="AppSecondaryTextColor">#99E8EAED</Color>

			<Color x:Key="AppSelectionColor">#FF2DD9C4</Color>
			<Color x:Key="AppDirtyIndicatorColor">#FF9384F2</Color>
			<Color x:Key="AppErrorColor">#FFF87171</Color>
			<Color x:Key="AppWarningColor">#FFFBBF24</Color>
			<Color x:Key="AppSuccessColor">#FF34D399</Color>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!-- Brushes derived from the tokens above — every Style in Styles.axaml
	     references these, never a raw Color, so a future palette change
	     only ever happens in this one file. -->
	<SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
	<SolidColorBrush x:Key="AppContentBackgroundBrush" Color="{DynamicResource AppContentBackgroundColor}" />
	<SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="{DynamicResource AppPanelBackgroundColor}" />
	<SolidColorBrush x:Key="AppControlBorderBrush" Color="{DynamicResource AppControlBorderColor}" />
	<SolidColorBrush x:Key="AppForegroundBrush" Color="{DynamicResource AppForegroundColor}" />
	<SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{DynamicResource AppForegroundColor}" />
	<SolidColorBrush x:Key="AppHoverBrush" Color="{DynamicResource AppHoverBrushColor}" />
	<SolidColorBrush x:Key="AppSelectionBrush" Color="{DynamicResource AppSelectionColor}" />
	<SolidColorBrush x:Key="AppDirtyIndicatorBrush" Color="{DynamicResource AppDirtyIndicatorColor}" />
	<SolidColorBrush x:Key="AppErrorBrush" Color="{DynamicResource AppErrorColor}" />
	<SolidColorBrush x:Key="AppWarningBrush" Color="{DynamicResource AppWarningColor}" />
	<SolidColorBrush x:Key="AppSuccessBrush" Color="{DynamicResource AppSuccessColor}" />
</ResourceDictionary>
