<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Width="480" Padding="20" Background="{DynamicResource AppBackgroundBrush}">
			<StackPanel Spacing="10">
				<TextBlock Classes="h1" Text="Moves" />
				<TextBlock Text="Regular body text sits here." />
				<TextBlock Classes="data" Text="0x0000A410  ID 3  Slot 0x2C" />
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Ellipse Classes="dirtyIndicator" />
					<TextBlock Text="Unsaved changes" Classes="caption" />
				</StackPanel>
				<Button Content="Save" Classes="accent" />
				<TextBox Text="Focus me" />
				<TabControl>
					<TabItem Header="General" />
					<TabItem Header="Stats" />
				</TabControl>
				<NumericUpDown />
				<ComboBox>
					<ComboBox.ItemsPanel>
						<ItemsPanelTemplate>
							<VirtualizingStackPanel />
						</ItemsPanelTemplate>
					</ComboBox.ItemsPanel>
				</ComboBox>
				<ListBox>
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Width" Value="150"/>
							<Setter Property="HorizontalAlignment" Value="Right"/>
						</Style>
					</ListBox.Styles>
					<ListBox.Items>
						<ListBoxItem>Burn!</ListBoxItem>
						<ListBoxItem>Burnflame</ListBoxItem>
						<ListBoxItem>Gravity</ListBoxItem>
						<ListBoxItem>BA-BOOM!</ListBoxItem>
						<ListBoxItem>Freeze!</ListBoxItem>
						<ListBoxItem>Tenseiken Slash</ListBoxItem>
					</ListBox.Items>
				</ListBox>
			</StackPanel>
		</Border>
	</Design.PreviewWith>

	<!-- ===================== Typography ===================== -->

	<Style Selector="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextWrapping" Value="WrapWithOverflow" />
	</Style>

	<Style Selector="TextBlock.h1">
		<Setter Property="FontSize" Value="22" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="LetterSpacing" Value="-0.3" />
		<Setter Property="Margin" Value="0,0,0,4" />
	</Style>

	<Style Selector="TextBlock.h2">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Margin" Value="0,0,0,2" />
	</Style>

	<Style Selector="TextBlock.caption">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
	</Style>

	<!-- Monospace, for hex offsets / chunk IDs / raw byte values —
	     anywhere the app shows reverse-engineered file data rather than
	     user-facing prose. -->
	<Style Selector="TextBlock.data">
		<Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style Selector="TextBlock.error">
		<Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
	</Style>

	<Style Selector="TextBlock.warning">
		<Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
	</Style>

	<Style Selector="TextBlock.success">
		<Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
	</Style>

	<!-- ===================== Unsaved-changes indicator ===================== -->

	<Style Selector="Ellipse.dirtyIndicator">
		<Setter Property="Width" Value="7" />
		<Setter Property="Height" Value="7" />
		<Setter Property="Fill" Value="{DynamicResource AppDirtyIndicatorBrush}" />
	</Style>

	<!-- ===================== Panels / cards ===================== -->

	<Style Selector="Border.panel">
		<Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="14" />
		<Setter Property="BoxShadow" Value="0 1 3 0 #22000000" />
	</Style>

	<!-- ===================== Buttons ===================== -->

	<Style Selector="Button">
		<Setter Property="MinWidth" Value="72" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="14,6" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.1" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Button.accent">
		<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
		<Setter Property="Foreground" Value="White" />
	</Style>

	<Style Selector="Button.accent:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
	</Style>

	<Style Selector="Button.accent:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
	</Style>

	<!-- ===================== TabItem ===================== -->

	<Style Selector="TabItem">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Padding" Value="14,8" />
	</Style>

	<Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
		<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
		<Setter Property="BorderThickness" Value="0,0,0,2" />
	</Style>

	<Style Selector="TabItem:selected TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!-- ===================== ListBox (nav rail + feature lists — Moves, Skills, ...) ===================== -->

	<Style Selector="ListBox">
		<Setter Property="Background" Value="{DynamicResource AppContentBackgroundBrush}" />
	</Style>

	<Style Selector="ListBoxItem">
		<Setter Property="Padding" Value="10,7" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Margin" Value="2,1" />
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.08" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
	</Style>

	<Style Selector="ListBoxItem:selected TextBlock">
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontWeight" Value="Medium" />
	</Style>

	<!-- ===================== ComboBox ===================== -->

	<Style Selector="ComboBox">
		<Setter Property="MinWidth" Value="160" />
	</Style>

	<!-- ===================== NumericUpDown ===================== -->

	<Style Selector="NumericUpDown">
		<Setter Property="MinWidth" Value="150"/>
	</Style>

	<!-- ===================== TextBox ===================== -->

	<Style Selector="TextBox">
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Background" Value="{DynamicResource AppContentBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
	</Style>

	<!-- Accent-colored focus ring — a standard modern-form detail this
	     didn't have before. PART_BorderElement is the FluentTheme
	     TextBox's own border template part. -->
	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
		<Setter Property="BorderThickness" Value="1.5" />
	</Style>

	<!-- Number/hex-entry fields — anywhere the ViewModel property is a raw
	     byte/short/int backing reverse-engineered data, not free text. -->
	<Style Selector="TextBox.data">
		<Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
	</Style>

	<!-- ===================== Separator ===================== -->

	<Style Selector="Separator">
		<Setter Property="Background" Value="{DynamicResource AppControlBorderBrush}" />
		<Setter Property="MinHeight" Value="1" />
	</Style>

	<!-- ===================== Flyouts / menus ===================== -->

	<Style Selector="FlyoutPresenter, ContextMenu, MenuFlyoutPresenter">
		<Setter Property="Background" Value="{DynamicResource AppContentBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Styles.Resources>
		<Thickness x:Key="PageMargin">24,16,24,16</Thickness>
		<x:Double x:Key="FontSizeSmall">11</x:Double>
		<x:Double x:Key="FontSizeNormal">13</x:Double>
		<x:Double x:Key="FontSizeLarge">16</x:Double>
	</Styles.Resources>
</Styles>
