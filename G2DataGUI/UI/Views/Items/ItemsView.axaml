<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:G2DataGUI.UI.ViewModels.Items"
			 xmlns:locale="using:G2DataGUI.UI.Common.Locale"
			 xmlns:common="using:G2DataGUI.Domain.Common"
			 xmlns:flags="using:G2DataGUI.UI.Common.ViewModels.Flags"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="700"
             x:Class="G2DataGUI.UI.Views.Items.ItemsView"
             x:DataType="vm:ItemsViewModel">
	<!-- Same list/detail shape as MovesView. Equipment/Usable are the
	     structural difference — each is a section the user can turn on or
	     off (IsEquipmentEnabled/IsUsableEnabled), backed by real
	     create/remove logic on GameItemViewModel, not just a visibility
	     toggle over data that's always there. Unchecking removes the
	     block from the model entirely (Item.Equipment/Usable go back to
	     null) rather than just hiding already-edited values. -->
	<Grid Name="ItemsPage" Margin="4">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0"
			        Background="{DynamicResource AppPanelBackgroundBrush}"
			        BorderBrush="{DynamicResource AppControlBorderBrush}"
			        BorderThickness="1">
			<ListBox x:Name="ItemsList"
					 ItemsSource="{Binding Items}"
					 SelectedItem="{Binding SelectedItem}"
					 Margin="2">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Width" Value="175" />
						<Setter Property="HorizontalAlignment" Value="Right" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4" Padding="10" HorizontalAlignment="Stretch" ClipToBounds="True">
							<TextBlock Text="{Binding Name}" />
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<ScrollViewer Grid.Column="1"
		              IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<Grid x:Name="ItemGrid"
				  Margin="20,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0"
							Margin="8"
							DataContext="{Binding SelectedItem}">
					<StackPanel Margin="4">
						<TextBlock Text="Name:" />
						<TextBox Text="{Binding Name}"
								 MaxLength="{Binding MaxNameLength}" />
					</StackPanel>
					<StackPanel Margin="4">
						<TextBlock Text="Description:" />
						<TextBox Text="{Binding Description}"
								 MaxLength="{Binding MaxDescriptionLength}" />
					</StackPanel>
					<StackPanel Margin="4">
						<TextBlock Text="Description:" />
						<TextBox Text="{Binding Description}"
								 MaxLength="{Binding MaxDescriptionLength}" />
					</StackPanel>
					<StackPanel Margin="4">
					<TextBlock Text="Entry Type:" />
					<ComboBox HorizontalAlignment="Stretch"
							  SelectedIndex="{Binding Stats.EntryType}"
							  ItemsSource="{locale:Locale ItemEntries}" />
					</StackPanel>
					<StackPanel DataContext="{Binding Stats}">
						<StackPanel Margin="4">
							<TextBlock Text="Unknown #1:" />
							<NumericUpDown Value="{Binding Unknown1}"
										   Increment="1"
										   Minimum="0"
										   Maximum="255" />
						</StackPanel>
						<StackPanel Margin="4">
							<TextBlock Text="Unknown #2:" />
							<NumericUpDown Value="{Binding Unknown2}"
										   Increment="1"
										   Minimum="0"
										   Maximum="255" />
						</StackPanel>
						<StackPanel Margin="4">
							<TextBlock Text="Unknown #3:" />
							<NumericUpDown Value="{Binding Unknown3}"
										   Increment="1"
										   Minimum="0"
										   Maximum="255" />
						</StackPanel>
						<StackPanel Margin="4">
							<TextBlock Text="Icon:" />
							<NumericUpDown Value="{Binding Icon}"
										   Increment="1"
										   Minimum="0"
										   Maximum="255" />
						</StackPanel>
						<StackPanel Margin="4">
							<TextBlock Text="Unknown #4:" />
							<NumericUpDown Value="{Binding Unknown4}"
										   Increment="1"
										   Minimum="0"
										   Maximum="255" />
						</StackPanel>
						<StackPanel Margin="4">
							<TextBlock Text="Price:" />
							<NumericUpDown Value="{Binding Price}"
										   Increment="1"
										   Minimum="-2147483648"
										   Maximum="2147483647" />
						</StackPanel>
					</StackPanel>
					<CheckBox Name="HasEquipment"
							  IsThreeState="False"
							  IsChecked="{Binding IsEquipmentEnabled}">
						Has Equipment?
					</CheckBox>
					<CheckBox Name="HasUsable"
								IsThreeState="False"
								IsChecked="{Binding IsUsableEnabled}">
						Has Usable?
					</CheckBox>
				</StackPanel>

				<!-- ===================== Equip-able section ===================== -->
				<StackPanel Grid.Column="1"
							Margin="8"
							DataContext="{Binding SelectedItem}"
							IsVisible="{Binding IsEquipmentEnabled}">
					<TextBlock Text="Item Equipment"
							   HorizontalAlignment="Center"
							   Classes="h1" />

					<StackPanel Margin="24,14"
								DataContext="{Binding Equipment}">
						<TextBlock Text="{Binding Characters.Title}" Classes="h2" HorizontalAlignment="Center" />
						<ItemsControl ItemsSource="{Binding Characters.Options}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="2" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Equipment}">
						<TextBlock Text="Stats"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Strength:" Classes="caption" />
								<NumericUpDown Value="{Binding Strength}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Vitality:" Classes="caption" />
								<NumericUpDown Value="{Binding Vitality}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Action:" Classes="caption" />
								<NumericUpDown Value="{Binding Action}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Movement:" Classes="caption" />
								<NumericUpDown Value="{Binding Movement}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Equipment}">
						<TextBlock Text="Element Affinity"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Fire:" Classes="caption" />
								<NumericUpDown Value="{Binding FireAffinity}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Wind:" Classes="caption" />
								<NumericUpDown Value="{Binding WindAffinity}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Earth:" Classes="caption" />
								<NumericUpDown Value="{Binding EarthAffinity}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Lightning:" Classes="caption" />
								<NumericUpDown Value="{Binding LightningAffinity}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Blizzard:" Classes="caption" />
								<NumericUpDown Value="{Binding BlizzardAffinity}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Equipment}">
						<TextBlock Text="{Binding Ailments.Title}" Classes="h2" HorizontalAlignment="Center" />
						<ItemsControl ItemsSource="{Binding Ailments.Options}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="2" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel Margin="4">
							<TextBlock Text="Ailments Chance:" Classes="caption" />
							<NumericUpDown Value="{Binding AilmentsChance}" Minimum="0" Maximum="255" />
						</StackPanel>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Equipment}">
						<TextBlock Text="Element % Increases"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Fire:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseFirePercent}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Wind:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseWindPercent}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Earth:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseEarthPercent}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Lightning:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseLightningPercent}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Blizzard:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseBlizzardPercent}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Water:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseWaterPercent}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Explosion:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseExplosionPercent}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Forest:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseForestPercent}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Equipment}">
						<TextBlock Text="Misc."
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Effective On:" Classes="caption" />
								<ComboBox HorizontalAlignment="Stretch"
										  SelectedIndex="{Binding EffectiveOn}"
										  ItemsSource="{locale:Locale EffectiveOn}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Special:" Classes="caption" />
								<NumericUpDown Value="{Binding Special}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</StackPanel>
				<!-- ===================== End Equip-able section ===================== -->
				
				<!-- ===================== Usable section ===================== -->
				<StackPanel Grid.Column="2"
							Margin="8"
							DataContext="{Binding SelectedItem}"
							IsVisible="{Binding IsUsableEnabled}">
					<TextBlock Text="Item Usable"
							   HorizontalAlignment="Center"
							   Classes="h1" />

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="Targetting"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Target Effect:" Classes="caption" />
								<NumericUpDown Value="{Binding TargetEffect}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Target Type:" Classes="caption" />
								<NumericUpDown Value="{Binding TargetType}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Range:" Classes="caption" />
								<NumericUpDown Value="{Binding Range}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Knockback:" Classes="caption" />
								<NumericUpDown Value="{Binding Knockback}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="Casting"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Cast Time:" Classes="caption" />
								<NumericUpDown Value="{Binding CastTime}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Recovery Time:" Classes="caption" />
								<NumericUpDown Value="{Binding RecoveryTime}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Range:" Classes="caption" />
								<NumericUpDown Value="{Binding Animation}" Minimum="-32768" Maximum="32767" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="Stats"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Power:" Classes="caption" />
								<NumericUpDown Value="{Binding Power}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="IP"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="IP Damage:" Classes="caption" />
								<NumericUpDown Value="{Binding IpDamage}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="IP Cancel Damage:" Classes="caption" />
								<NumericUpDown Value="{Binding IpCancelDamage}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="{Binding Ailments.Title}" Classes="h2" HorizontalAlignment="Center" />
						<ItemsControl ItemsSource="{Binding Ailments.Options}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="2" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel Margin="4">
							<TextBlock Text="Ailments Chance:" Classes="caption" />
							<NumericUpDown Value="{Binding AilmentsChance}" Minimum="0" Maximum="255" />
						</StackPanel>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="Modifiers"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Attack:" Classes="caption" />
								<NumericUpDown Value="{Binding AttackModifier}" Minimum="-128" Maximum="127" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Defense:" Classes="caption" />
								<NumericUpDown Value="{Binding DefenseModifier}" Minimum="-128" Maximum="127" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Action:" Classes="caption" />
								<NumericUpDown Value="{Binding ActionModifier}" Minimum="-128" Maximum="127" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Movement:" Classes="caption" />
								<NumericUpDown Value="{Binding MovementModifier}" Minimum="-128" Maximum="127" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="Element Affinity"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Element:" Classes="caption" />
								<ComboBox HorizontalAlignment="Stretch"
										  SelectedIndex="{Binding Element}"
										  ItemsSource="{locale:Locale Elements}" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Element Strength:" Classes="caption" />
								<NumericUpDown Value="{Binding ElementStrength}"
												   Increment="1"
												   Minimum="0"
												   Maximum="10" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="Misc."
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="0,0,4,0">
								<TextBlock Text="Break Chance" Classes="caption" />
								<NumericUpDown Value="{Binding BreakChance}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4,0">
								<TextBlock Text="Special" Classes="caption" />
								<NumericUpDown Value="{Binding Special}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
					</StackPanel>

					<StackPanel Margin="24,14"
								DataContext="{Binding Usable}">
						<TextBlock Text="Unknowns"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Unknown 1" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown1}" Minimum="0" Maximum="255" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="Unknown 2" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown2}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="Unknown 3" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown3}" Minimum="0" Maximum="255" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</StackPanel>
				<!-- ===================== End Usable section ===================== -->
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
