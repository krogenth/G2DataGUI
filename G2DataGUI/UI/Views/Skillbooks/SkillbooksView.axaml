<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:G2DataGUI.UI.ViewModels.Skillbooks"
             xmlns:skills="clr-namespace:G2DataGUI.UI.ViewModels.Skills"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             x:Class="G2DataGUI.UI.Views.Skillbooks.SkillbooksView"
             x:DataType="vm:SkillbooksViewModel">
	<Grid Name="SkillbooksPage" Margin="4">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0"
			        Background="{DynamicResource AppPanelBackgroundBrush}"
			        BorderBrush="{DynamicResource AppControlBorderBrush}"
			        BorderThickness="1">
			<ListBox x:Name="SkillbooksList"
					 ItemsSource="{Binding Items}"
					 SelectedItem="{Binding SelectedItem}"
					 Margin="2">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Width" Value="140" />
						<Setter Property="HorizontalAlignment" Value="Right" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4" Padding="10" HorizontalAlignment="Stretch" ClipToBounds="True">
							<TextBlock Text="{Binding Id, StringFormat='Skillbook {0}'}" />
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<ScrollViewer Grid.Column="1"
					  HorizontalScrollBarVisibility="Disabled"
					  HorizontalAlignment="Stretch"
		              IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<StackPanel Margin="24,14">
				<ItemsControl ItemsSource="{Binding SelectedItem.Skills}" HorizontalAlignment="Stretch">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:SkillbookSkillViewModel">
							<StackPanel HorizontalAlignment="Stretch">
								<StackPanel Margin="4" HorizontalAlignment="Stretch">
									<TextBlock Text="Skill:" Classes="caption" />
									<ComboBox HorizontalAlignment="Stretch"
											  ItemsSource="{Binding AvailableSkills}"
											  SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
											  PlaceholderText="(unresolved skill offset)">
										<ComboBox.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel />
											</ItemsPanelTemplate>
										</ComboBox.ItemsPanel>
										<ComboBox.ItemTemplate>
											<DataTemplate x:DataType="skills:SkillViewModel">
												<TextBlock Text="{Binding Name}" />
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<TextBlock Text="{Binding SkillOffset, StringFormat='raw offset: 0x{0:X2}'}"
											   Classes="data caption"
											   Margin="0,2,0,0" />
								</StackPanel>

								<StackPanel Margin="4">
									<TextBlock Text="Starting Lvl" Classes="caption" />
									<NumericUpDown Value="{Binding StartingLevel}" Minimum="0" Maximum="255" />
								</StackPanel>

								<StackPanel Margin="4">
									<TextBlock Text="Required Lvl" Classes="caption" />
									<NumericUpDown Value="{Binding RequiredLevel}" Minimum="0" Maximum="255" />
								</StackPanel>
									
								<StackPanel Margin="4">
									<TextBlock Text="Unknown #1" Classes="caption" />
									<NumericUpDown Value="{Binding Unknown1}" Minimum="0" Maximum="255" />
								</StackPanel>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
