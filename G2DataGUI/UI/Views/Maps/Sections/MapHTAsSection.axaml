<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sections="clr-namespace:G2DataGUI.UI.ViewModels.Maps.Sections"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="G2DataGUI.UI.Views.Maps.Sections.MapHTAsSection"
             x:DataType="sections:MapHTAsViewModel">
	<Grid ColumnDefinitions="Auto,*">
		<ListBox Grid.Column="0"
		         ItemsSource="{Binding Items}"
		         SelectedItem="{Binding SelectedItem}">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Width" Value="120" />
					<Setter Property="HorizontalAlignment" Value="Right" />
				</Style>
			</ListBox.Styles>
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="sections:MapHTAViewModel">
					<TextBlock Text="{Binding Shape, StringFormat='HTA (Shape {0})'}" Classes="data" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<ScrollViewer Grid.Column="1"
		              IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<StackPanel Margin="16,10" DataContext="{Binding SelectedItem}" x:DataType="sections:MapHTAViewModel" MaxWidth="640" Spacing="4">
				<TextBlock Text="{Binding Shape, StringFormat='HTA (Shape {0})'}" Classes="h1" />
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Shape" Classes="caption" /><NumericUpDown Value="{Binding Shape}" Minimum="0" Maximum="255" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Type" Classes="caption" /><NumericUpDown Value="{Binding Type}" Minimum="0" Maximum="255" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="Trigger" Classes="caption" /><NumericUpDown Value="{Binding Trigger}" Minimum="0" Maximum="255" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="Attribute" Classes="caption" /><NumericUpDown Value="{Binding Attribute}" Minimum="0" Maximum="255" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unknown #1" Classes="caption" /><NumericUpDown Value="{Binding Unknown1}" Minimum="0" Maximum="255" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Unknown #3" Classes="caption" /><NumericUpDown Value="{Binding Unknown3}" Minimum="0" Maximum="255" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unknown #2" Classes="caption" /><NumericUpDown Value="{Binding Unknown2}" Minimum="-2147483648" Maximum="2147483647" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Unknown #4" Classes="caption" /><NumericUpDown Value="{Binding Unknown4}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
<TextBlock Text="Unknown #5" Classes="caption" /><NumericUpDown Value="{Binding Unknown5}" Increment="0.01" FormatString="0.00" />				<TextBlock Text="Minimum" Classes="h2" Margin="0,8,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" Classes="caption" /><NumericUpDown Value="{Binding MinimumX}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Y" Classes="caption" /><NumericUpDown Value="{Binding MinimumY}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" Classes="caption" /><NumericUpDown Value="{Binding MinimumZ}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>
				<TextBlock Text="Maximum" Classes="h2" Margin="0,8,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" Classes="caption" /><NumericUpDown Value="{Binding MaximumX}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Y" Classes="caption" /><NumericUpDown Value="{Binding MaximumY}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" Classes="caption" /><NumericUpDown Value="{Binding MaximumZ}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>
				<TextBlock Text="Unknown #6" Classes="h2" Margin="0,8,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" Classes="caption" /><NumericUpDown Value="{Binding Unknown6X}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Y" Classes="caption" /><NumericUpDown Value="{Binding Unknown6Y}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" Classes="caption" /><NumericUpDown Value="{Binding Unknown6Z}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unknown #7" Classes="caption" /><NumericUpDown Value="{Binding Unknown7}" Minimum="-2147483648" Maximum="2147483647" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Unknown #8" Classes="caption" /><NumericUpDown Value="{Binding Unknown8}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unknown #9" Classes="caption" /><NumericUpDown Value="{Binding Unknown9}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Unknown #10" Classes="caption" /><NumericUpDown Value="{Binding Unknown10}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>
<TextBlock Text="Unknown #11" Classes="caption" /><NumericUpDown Value="{Binding Unknown11}" Increment="0.01" FormatString="0.00" />			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
