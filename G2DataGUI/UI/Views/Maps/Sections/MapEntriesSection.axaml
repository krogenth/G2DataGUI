<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:G2DataGUI.UI.Common.ViewModels;assembly=G2DataGUI.UI.Common"
             xmlns:sections="clr-namespace:G2DataGUI.UI.ViewModels.Maps.Sections"
             xmlns:maps="clr-namespace:G2DataGUI.UI.ViewModels.Maps"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="G2DataGUI.UI.Views.Maps.Sections.MapEntriesSection"
             x:DataType="sections:MapEntriesViewModel">
	<!-- Template for every Maps sub-section: ListBox (Items/SelectedItem,
	     both on the shared MapSectionViewModel<T> base) on the left,
	     detail form on the right. Reused with the same shape for
	     Instances/HTAs/Scripts/EnemyPositions/EnemyGroups/MOSs/Icons.

	     Id also references another map (its 4-digit hex form is that
	     map's folder name — see MapEntryViewModel's own doc comment), so
	     it's a ComboBox over AvailableMaps (SelectedMap), not a plain
	     NumericUpDown. The raw value stays visible/editable too. -->
	<UserControl.Resources>
		<DataTemplate x:Key="MapPickerItemTemplate" x:DataType="maps:MapViewModel">
			<TextBlock Text="{Binding MapName}" />
		</DataTemplate>
	</UserControl.Resources>
	<Grid ColumnDefinitions="Auto,*">
		<ListBox Grid.Column="0"
		         ItemsSource="{Binding Items}"
		         SelectedItem="{Binding SelectedItem}">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Width" Value="120" />
					<Setter Property="HorizontalAlignment" Value="Right" />
				</Style>
			</ListBox.Styles>
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="sections:MapEntryViewModel">
					<TextBlock Text="{Binding Id, StringFormat='Entry {0}'}" Classes="data" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<ScrollViewer Grid.Column="1"
		              IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<StackPanel Margin="16,10" DataContext="{Binding SelectedItem}" x:DataType="sections:MapEntryViewModel" MaxWidth="420" Spacing="8">
				<TextBlock Text="{Binding Id, StringFormat='Entry {0}'}" Classes="h1" />

				<TextBlock Text="Target Map" Classes="h2" Margin="0,8,0,0" />
				<ComboBox HorizontalAlignment="Stretch"
				          ItemsSource="{Binding AvailableMaps}"
				          SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
				          ItemTemplate="{StaticResource MapPickerItemTemplate}"
				          PlaceholderText="(unresolved map id)" />
				<StackPanel>
					<TextBlock Text="Raw Id" Classes="caption" />
					<NumericUpDown Value="{Binding Id}" Minimum="0" Maximum="4294967295" />
				</StackPanel>

				<TextBlock Text="Position" Classes="h2" Margin="0,8,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" Classes="caption" /><NumericUpDown Value="{Binding PositionX}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Y" Classes="caption" /><NumericUpDown Value="{Binding PositionY}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" Classes="caption" /><NumericUpDown Value="{Binding PositionZ}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>

				<Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Direction" Classes="caption" /><NumericUpDown Value="{Binding Direction}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Unknown #1" Classes="caption" /><NumericUpDown Value="{Binding Unknown1}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unknown #2" Classes="caption" /><NumericUpDown Value="{Binding Unknown2}" Minimum="-2147483648" Maximum="2147483647" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Unknown #3" Classes="caption" /><NumericUpDown Value="{Binding Unknown3}" Minimum="-2147483648" Maximum="2147483647" /></StackPanel>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
