<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sections="clr-namespace:G2DataGUI.UI.ViewModels.Maps.Sections"
             xmlns:items="clr-namespace:G2DataGUI.UI.ViewModels.Items"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="G2DataGUI.UI.Views.Maps.Sections.MapIconsSection"
             x:DataType="sections:MapIconsViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="ItemPickerItemTemplate" x:DataType="items:GameItemViewModel">
			<TextBlock Text="{Binding Name}" />
		</DataTemplate>
	</UserControl.Resources>
	<Grid ColumnDefinitions="Auto,*">
		<ListBox Grid.Column="0"
		         ItemsSource="{Binding Items}"
		         SelectedItem="{Binding SelectedItem}">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Width" Value="120" />
					<Setter Property="HorizontalAlignment" Value="Right" />
				</Style>
			</ListBox.Styles>
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="sections:MapIconViewModel">
					<TextBlock Text="{Binding Id, StringFormat='Icon {0}'}" Classes="data" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<ScrollViewer Grid.Column="1"
		              IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<StackPanel Margin="16,10" DataContext="{Binding SelectedItem}" x:DataType="sections:MapIconViewModel" MaxWidth="420" Spacing="6">
				<TextBlock Text="{Binding Id, StringFormat='Icon {0}'}" Classes="h1" />

				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unknown #1" Classes="caption" /><NumericUpDown Value="{Binding Unknown1}" Minimum="0" Maximum="255" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Unknown #2" Classes="caption" /><NumericUpDown Value="{Binding Unknown2}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>

				<TextBlock Text="Position" Classes="h2" Margin="0,8,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" Classes="caption" /><NumericUpDown Value="{Binding PositionX}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Y" Classes="caption" /><NumericUpDown Value="{Binding PositionY}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" Classes="caption" /><NumericUpDown Value="{Binding PositionZ}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>

				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unknown #3" Classes="caption" /><NumericUpDown Value="{Binding Unknown3}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Y Angle" Classes="caption" /><NumericUpDown Value="{Binding YAngle}" Increment="0.01" FormatString="0.00" /></StackPanel>
				</Grid>

				<TextBlock Text="Items" Classes="h2" Margin="0,8,0,0" />
				<StackPanel>
					<TextBlock Text="Item 1" Classes="caption" />
					<ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedItem1, Mode=TwoWay}" ItemTemplate="{StaticResource ItemPickerItemTemplate}" PlaceholderText="(unresolved item offset)" />
					<TextBlock Text="{Binding Item1Offset, StringFormat='raw offset: 0x{0:X4}'}" Classes="data caption" />
				</StackPanel>
				<StackPanel Margin="0,6,0,0">
					<TextBlock Text="Item 2" Classes="caption" />
					<ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedItem2, Mode=TwoWay}" ItemTemplate="{StaticResource ItemPickerItemTemplate}" PlaceholderText="(unresolved item offset)" />
					<TextBlock Text="{Binding Item2Offset, StringFormat='raw offset: 0x{0:X4}'}" Classes="data caption" />
				</StackPanel>
				<StackPanel Margin="0,6,0,0">
					<TextBlock Text="Item 3" Classes="caption" />
					<ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedItem3, Mode=TwoWay}" ItemTemplate="{StaticResource ItemPickerItemTemplate}" PlaceholderText="(unresolved item offset)" />
					<TextBlock Text="{Binding Item3Offset, StringFormat='raw offset: 0x{0:X4}'}" Classes="data caption" />
				</StackPanel>

				<StackPanel Margin="0,8,0,0">
					<TextBlock Text="Flag" Classes="caption" />
					<NumericUpDown Value="{Binding Flag}" Minimum="-32768" Maximum="32767" HorizontalAlignment="Left" Width="140" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
