<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sections="clr-namespace:G2DataGUI.UI.ViewModels.Maps.Sections"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="G2DataGUI.UI.Views.Maps.Sections.MapEnemyGroupsSection"
             x:DataType="sections:MapEnemyGroupsViewModel">
	<Grid ColumnDefinitions="Auto,*">
		<ListBox Grid.Column="0"
		         ItemsSource="{Binding Items}"
		         SelectedItem="{Binding SelectedItem}">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Width" Value="120" />
					<Setter Property="HorizontalAlignment" Value="Right" />
				</Style>
			</ListBox.Styles>
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="sections:MapEnemyGroupViewModel">
					<TextBlock Text="{Binding Index, StringFormat='Enemy Group {0}'}" Classes="data" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<ScrollViewer Grid.Column="1"
		              IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<StackPanel Margin="16,10" DataContext="{Binding SelectedItem}" x:DataType="sections:MapEnemyGroupViewModel" MaxWidth="640" Spacing="4">
				<TextBlock Text="{Binding Index, StringFormat='Enemy Group {0}'}" Classes="h1" />
				<TextBlock Text="Unknown Block 1" Classes="h2" Margin="0,8,0,0" />
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#1" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown1}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#2" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown2}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="#3" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown3}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="#4" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown4}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#5" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown5}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#6" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown6}" Increment="0.01" FormatString="0.00" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="#7" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown7}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="#8" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown8}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#9" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown9}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#10" Classes="caption" /><NumericUpDown Value="{Binding FirstUnknown10}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"></StackPanel>
				</Grid>
				<TextBlock Text="Enemy Slots" Classes="h2" Margin="0,8,0,0" />
				<TextBlock Text="Enemy 1" Classes="caption" Margin="0,4,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Index" Classes="caption" /><NumericUpDown Value="{Binding Enemy1Index}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Count" Classes="caption" /><NumericUpDown Value="{Binding Enemy1EnemyCount}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Offset (raw)" Classes="caption" /><NumericUpDown Value="{Binding Enemy1EnemyOffset}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unk #1" Classes="caption" /><NumericUpDown Value="{Binding Enemy1Unknown1}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Unk #2" Classes="caption" /><NumericUpDown Value="{Binding Enemy1Unknown2}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="Unk #3" Classes="caption" /><NumericUpDown Value="{Binding Enemy1Unknown3}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="Unk #4" Classes="caption" /><NumericUpDown Value="{Binding Enemy1Unknown4}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<TextBlock Text="Enemy 2" Classes="caption" Margin="0,4,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Index" Classes="caption" /><NumericUpDown Value="{Binding Enemy2Index}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Count" Classes="caption" /><NumericUpDown Value="{Binding Enemy2EnemyCount}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Offset (raw)" Classes="caption" /><NumericUpDown Value="{Binding Enemy2EnemyOffset}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unk #1" Classes="caption" /><NumericUpDown Value="{Binding Enemy2Unknown1}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Unk #2" Classes="caption" /><NumericUpDown Value="{Binding Enemy2Unknown2}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="Unk #3" Classes="caption" /><NumericUpDown Value="{Binding Enemy2Unknown3}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="Unk #4" Classes="caption" /><NumericUpDown Value="{Binding Enemy2Unknown4}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<TextBlock Text="Enemy 3" Classes="caption" Margin="0,4,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Index" Classes="caption" /><NumericUpDown Value="{Binding Enemy3Index}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Count" Classes="caption" /><NumericUpDown Value="{Binding Enemy3EnemyCount}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Offset (raw)" Classes="caption" /><NumericUpDown Value="{Binding Enemy3EnemyOffset}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unk #1" Classes="caption" /><NumericUpDown Value="{Binding Enemy3Unknown1}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Unk #2" Classes="caption" /><NumericUpDown Value="{Binding Enemy3Unknown2}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="Unk #3" Classes="caption" /><NumericUpDown Value="{Binding Enemy3Unknown3}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="Unk #4" Classes="caption" /><NumericUpDown Value="{Binding Enemy3Unknown4}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<TextBlock Text="Enemy 4" Classes="caption" Margin="0,4,0,0" />
				<Grid ColumnDefinitions="*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Index" Classes="caption" /><NumericUpDown Value="{Binding Enemy4Index}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Count" Classes="caption" /><NumericUpDown Value="{Binding Enemy4EnemyCount}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Offset (raw)" Classes="caption" /><NumericUpDown Value="{Binding Enemy4EnemyOffset}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Unk #1" Classes="caption" /><NumericUpDown Value="{Binding Enemy4Unknown1}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Unk #2" Classes="caption" /><NumericUpDown Value="{Binding Enemy4Unknown2}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="Unk #3" Classes="caption" /><NumericUpDown Value="{Binding Enemy4Unknown3}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="Unk #4" Classes="caption" /><NumericUpDown Value="{Binding Enemy4Unknown4}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<TextBlock Text="Unknown Block 2" Classes="h2" Margin="0,8,0,0" />
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#1" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown1}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#2" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown2}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="#3" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown3}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="#4" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown4}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#5" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown5}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#6" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown6}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="#7" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown7}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="#8" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown8}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#9" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown9}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#10" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown10}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="#11" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown11}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="#12" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown12}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#13" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown13}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#14" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown14}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="#15" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown15}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="#16" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown16}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
				<Grid ColumnDefinitions="*,*,*,*">
					<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="#17" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown17}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="#18" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown18}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="#19" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown19}" Minimum="-32768" Maximum="32767" /></StackPanel>
					<StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="#20" Classes="caption" /><NumericUpDown Value="{Binding SecondUnknown20}" Minimum="-32768" Maximum="32767" /></StackPanel>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
