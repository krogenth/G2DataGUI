<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:G2DataGUI.UI.ViewModels.Skills"
			 xmlns:locale="using:G2DataGUI.UI.Common.Locale"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="G2DataGUI.UI.Views.Skills.SkillsView"
             x:DataType="vm:SkillsViewModel">
	<!-- Same shape as MovesView — Skills' domain fields are the moves'
	     shape with a few different names (BaseHP/BaseMP/... instead of
	     Cost/Power, elemental %-increases, coin costs). -->
	<Grid Name="SkillsPage" Margin="4">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0"
			        Background="{DynamicResource AppPanelBackgroundBrush}"
			        BorderBrush="{DynamicResource AppControlBorderBrush}"
			        BorderThickness="1">
			<ListBox x:Name="SkillsList"
					 ItemsSource="{Binding Items}"
					 SelectedItem="{Binding SelectedItem}"
					 Margin="2">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Width" Value="175" />
						<Setter Property="HorizontalAlignment" Value="Right" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4" Padding="10" HorizontalAlignment="Stretch" ClipToBounds="True">
							<TextBlock Text="{Binding Name}" />
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<ScrollViewer Grid.Column="1"
		              IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<Grid x:Name="SkillGrid"
				  Margin="20,10"
				  DataContext="{Binding SelectedItem}"
				  VerticalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<StackPanel Grid.Column="0"
							Margin="8">
					<StackPanel Margin="24,14">
						<StackPanel Margin="4">
							<TextBlock Text="Name:" Classes="caption" />
							<TextBox Text="{Binding Name}" />
						</StackPanel>
						<StackPanel Margin="4">
							<TextBlock Text="Description:" Classes="caption" />
							<TextBox Text="{Binding Description}"
									 TextWrapping="Wrap" />
						</StackPanel>
					</StackPanel>
					<StackPanel Margin="4">
						<TextBlock Text="Cost Type"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid Margin="20,10"
							  DataContext="{Binding Stats}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Cost Type 1:" Classes="caption" />
								<ComboBox HorizontalAlignment="Stretch"
										  SelectedItem="{Binding CostType1}"
										  ItemsSource="{locale:Locale CoinCostTypes}" />
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Cost Type 2:" Classes="caption" />
								<ComboBox HorizontalAlignment="Stretch"
										  SelectedItem="{Binding CostType2}"
										  ItemsSource="{locale:Locale CoinCostTypes}" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.Column="1"
							Margin="8"
							DataContext="{Binding Stats}">
					<StackPanel Margin="24,14">
						<TextBlock Text="Base Stats"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
									Grid.Column="0">
								<TextBlock Text="Base HP:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseHP}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
									Grid.Column="0">
								<TextBlock Text="Base SP:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseSP}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Base MP:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseMP}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Base Strength:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseStrength}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
							<StackPanel Margin="4"
									Grid.Column="1">
								<TextBlock Text="Base Vitality:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseVitality}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Base Action:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseAction}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
							<StackPanel Margin="4"
									Grid.Column="1">
								<TextBlock Text="Base Movement:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseMovement}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Base Magic:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseMagic}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Base Mentality:" Classes="caption" />
								<NumericUpDown Value="{Binding BaseMentality}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="Unknowns"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Unknown #1:" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown1}"
												Increment="1"
												Minimum="0"
												Maximum="255"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Unknown #2:" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown2}"
												Increment="1"
												Minimum="0"
												Maximum="255"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Unknown #3:" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown3}"
												Increment="1"
												Minimum="0"
												Maximum="255"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Unknown #4:" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown4}"
												Increment="1"
												Minimum="0"
												Maximum="255"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Unknown #5:" Classes="caption" />
								<NumericUpDown Value="{Binding Unknown5}"
												Increment="1"
												Minimum="0"
												Maximum="255"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.Column="2"
							Margin="8"
							DataContext="{Binding Stats}">
					<StackPanel Margin="24,14">
						<TextBlock Text="Element % Increases"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Fire:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseFirePercent}"
												Increment="1"
												Minimum="-128"
												Maximum="127"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Wind:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseWindPercent}"
												Increment="1"
												Minimum="-128"
												Maximum="127"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Earth:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseEarthPercent}"
												Increment="1"
												Minimum="-128"
												Maximum="127"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Lightning:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseLightningPercent}"
												Increment="1"
												Minimum="-128"
												Maximum="127"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Blizzard:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseBlizzardPercent}"
												Increment="1"
												Minimum="-128"
												Maximum="127"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Water:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseWaterPercent}"
												Increment="1"
												Minimum="-128"
												Maximum="127"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Explosion:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseExplosionPercent}"
												Increment="1"
												Minimum="-128"
												Maximum="127"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Forest:" Classes="caption" />
								<NumericUpDown Value="{Binding IncreaseForestPercent}"
											   Increment="1"
											   Minimum="-128"
											   Maximum="127"/>
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="Coin Costs"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Level 1:" Classes="caption" />
								<NumericUpDown Value="{Binding CoinCost1}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Level 2:" Classes="caption" />
								<NumericUpDown Value="{Binding CoinCost2}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Level 3:" Classes="caption" />
								<NumericUpDown Value="{Binding CoinCost3}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Level 4:" Classes="caption" />
								<NumericUpDown Value="{Binding CoinCost4}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Level 5:" Classes="caption" />
								<NumericUpDown Value="{Binding CoinCost5}"
												Increment="1"
												Minimum="-32768"
												Maximum="32767"/>
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<StackPanel>
							<TextBlock Text="Special"
									   HorizontalAlignment="Center"
									   Classes="h2" />
							<Grid>
								<StackPanel Margin="4">
									<TextBlock Text="Special:" Classes="caption" />
									<NumericUpDown Value="{Binding Special}"
										   Increment="1"
										   Minimum="0"
										   Maximum="65536" />
								</StackPanel>
							</Grid>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
