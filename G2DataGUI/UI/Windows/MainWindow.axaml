<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:G2DataGUI.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="G2DataGUI.UI.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="G2DataGUI">

	<DockPanel>

		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_Open Project..." Click="OnOpenProjectClick" />
				<Separator />
				<MenuItem Header="_Save"
				          Click="OnSaveClick"
				          IsEnabled="{Binding !IsBusy}"
				          InputGesture="Ctrl+S" />
			</MenuItem>
		</Menu>

		<!-- Toolbar: Save + Normal/Hard version toggle + status. Only
		     meaningful once a project is loaded, so the whole row hides
		     until then rather than showing disabled controls with
		     nothing to act on. -->
		<Border DockPanel.Dock="Top"
		        Background="{DynamicResource AppPanelBackgroundBrush}"
		        BorderBrush="{DynamicResource AppControlBorderBrush}"
		        BorderThickness="0,0,0,1"
		        IsVisible="{Binding Project, Converter={x:Static ObjectConverters.IsNotNull}}"
		        Padding="12,8">
			<StackPanel Orientation="Horizontal" Spacing="12">

				<Button Content="Save"
				        Classes="accent"
				        Click="OnSaveClick"
				        IsEnabled="{Binding !IsBusy}" />

				<Separator />

				<!-- Grouped RadioButtons rather than a two-way-bound
				     ToggleSwitch — IsNormalVersion/IsHardVersion are
				     read-only (they reflect Project.CurrentVersion, not
				     something a plain property setter should silently
				     kick off an async version switch from); the actual
				     switch happens explicitly in code-behind's
				     OnNormalVersionClick/OnHardVersionClick. -->
				<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
					<RadioButton GroupName="GameVersion"
					             Content="Normal"
					             IsChecked="{Binding IsNormalVersion, Mode=OneWay}"
					             Click="OnNormalVersionClick"
					             IsEnabled="{Binding !IsBusy}" />
					<RadioButton GroupName="GameVersion"
					             Content="Hard"
					             IsChecked="{Binding IsHardVersion, Mode=OneWay}"
					             Click="OnHardVersionClick"
					             IsEnabled="{Binding !IsBusy}" />
				</StackPanel>

				<TextBlock Text="Working..."
				           Classes="caption"
				           VerticalAlignment="Center"
				           IsVisible="{Binding IsBusy}" />

				<TextBlock Text="{Binding ErrorMessage}"
				           Classes="error"
				           VerticalAlignment="Center"
				           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

			</StackPanel>
		</Border>

		<Grid ColumnDefinitions="150,*">

			<!-- Navigation rail. Reuses the same ListBox styling as every
			     feature's own item list (Styles.axaml) — the nav rail is
			     itself just a list, no special-casing needed. -->
			<Border Grid.Column="0"
			        Background="{DynamicResource AppPanelBackgroundBrush}"
			        BorderBrush="{DynamicResource AppControlBorderBrush}"
			        BorderThickness="0,0,1,0">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top"
					           Classes="h2"
					           Text="G2DataGUI"
					           Margin="12,12,12,8" />

					<TextBlock DockPanel.Dock="Top"
					           Classes="caption"
					           Text="Open a project to get started"
					           Margin="12,0,12,8"
					           IsVisible="{Binding Project, Converter={x:Static ObjectConverters.IsNull}}" />

					<ListBox DockPanel.Dock="Top"
					         ItemsSource="{Binding NavigationItems}"
					         SelectedItem="{Binding SelectedItem}"
					         Margin="4,0,4,4">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Label}" Margin="8,4" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</Border>

			<!-- Current page. ContentControl.Content is a page ViewModel
			     (MovesViewModel, EnemiesViewModel, ...); ViewLocator
			     (registered application-wide in App.axaml) resolves it to
			     the matching View by naming convention. -->
			<ContentControl Grid.Column="1"
			                 Content="{Binding CurrentPage}"
			                 Margin="{DynamicResource PageMargin}" />

		</Grid>
	</DockPanel>
</Window>
