<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:G2DataGUI.ViewModels.Moves"
			 xmlns:locale="using:G2DataGUI.UI.Common.Locale"
             mc:Ignorable="d"
			 d:DesignWidth="760"
			 d:DesignHeight="500"
             x:Class="G2DataGUI.Views.Moves.MovesView"
             x:DataType="vm:MovesViewModel">
	<Grid Name="MovesPage"
		  Margin="4">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<ListBox x:Name="MovesList"
				 ItemsSource="{Binding Items}"
				 SelectedItem="{Binding SelectedItem}"
				 Grid.Column="0">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Width" Value="175"/>
					<Setter Property="HorizontalAlignment" Value="Right"/>
				</Style>
			</ListBox.Styles>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border CornerRadius="4"
							Margin="0"
							Padding="10"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							ClipToBounds="True">
						<TextBlock Text="{Binding Name, Mode=OneWay}" />
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
		<ScrollViewer Grid.Column="1"
					  IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
			<Grid x:Name="MoveDataGrid"
				  Margin="20,10"
				  VerticalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<StackPanel Margin="4" Grid.Column="0">
					<StackPanel Margin="24,14" >
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Name:" />
								<TextBox Text="{Binding SelectedItem.Name}"
										 MaxLength="{Binding SelectedItem.MaxNameLength}" />
							</StackPanel>
							<StackPanel Grid.Column="1"
										Margin="4">
								<TextBlock Text="Icon:" />
								<ComboBox HorizontalAlignment="Stretch"
										  SelectedIndex="{Binding SelectedItem.Icon}"
										  ItemsSource="{locale:Locale Icons}">
									<ComboBox.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel />
										</ItemsPanelTemplate>
									</ComboBox.ItemsPanel>
								</ComboBox>
							</StackPanel>
						</Grid>
						<StackPanel Margin="4">
							<TextBlock Text="Description:" />
							<TextBox Text="{Binding SelectedItem.Description}"
										MaxLength="{Binding SelectedItem.MaxDescriptionLength}" />
						</StackPanel>
					</StackPanel>
					<StackPanel Margin="24,14"
								Grid.Column="1">
						<TextBlock Text="Targetting"
									HorizontalAlignment="Center"
									Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0"
										Margin="4">
								<TextBlock Text="Target Effect:" />
								<ComboBox HorizontalAlignment="Stretch"
										SelectedIndex="{Binding SelectedItem.Stats.TargetEffect}"
										ItemsSource="{locale:Locale TargetEffects}">
									<ComboBox.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel />
										</ItemsPanelTemplate>
									</ComboBox.ItemsPanel>
								</ComboBox>
							</StackPanel>
							<StackPanel Grid.Column="1"
										Margin="4">
								<TextBlock Text="Target Type:" />
								<ComboBox HorizontalAlignment="Stretch"
											SelectedIndex="{Binding SelectedItem.Stats.TargetType}"
											ItemsSource="{locale:Locale TargetTypes}">
									<ComboBox.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel />
										</ItemsPanelTemplate>
									</ComboBox.ItemsPanel>
								</ComboBox>
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0"
										Margin="4">
								<TextBlock Text="Range:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Range}"
												Increment="1"
												Minimum="0"
												Maximum="65536" />
							</StackPanel>
							<StackPanel Margin="4"
									Grid.Column="1">
								<TextBlock Text="Knockback:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Knockback}"
												Increment="1"
												Minimum="0"
												Maximum="65536" />
							</StackPanel>
						</Grid>
						<StackPanel Margin="4">
							<CheckBox IsThreeState="False"
										IsChecked="{Binding SelectedItem.Stats.Knockdown}">
								Does Knockdown?
							</CheckBox>
						</StackPanel>
					</StackPanel>
					<StackPanel Margin="24,14"
								Grid.Column="2">
						<TextBlock Text="Casting"
									HorizontalAlignment="Center"
									Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Cast Time Level 1:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Cast1Time}"
												Increment="1"
												Minimum="0"
												Maximum="65536" />
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Cast Time Level 5:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Cast5Time}"
												Increment="1"
												Minimum="0"
												Maximum="65536" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Recovery Time:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.RecoveryTime}"
												Increment="1"
												Minimum="0"
												Maximum="65536" />
							</StackPanel>
							<StackPanel Grid.Column="1"
										Margin="4">
								<TextBlock Text="Animation:" />
								<ComboBox HorizontalAlignment="Stretch"
											SelectedIndex="{Binding SelectedItem.Stats.Animation}"
											ItemsSource="{locale:Locale Animations}">
									<ComboBox.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel />
										</ItemsPanelTemplate>
									</ComboBox.ItemsPanel>
								</ComboBox>
							</StackPanel>
						</Grid>
					</StackPanel>
				</StackPanel>
				<StackPanel Grid.Column="1"
							Margin="8">
					<StackPanel Margin="24,14">
						<TextBlock Text="Stats"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Cost:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Cost}"
											   Increment="1"
											   Minimum="0"
											   Maximum="65536" />
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Multiplier:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Multiplier}"
											   Increment="1"
											   Minimum="0"
											   Maximum="65536" />
							</StackPanel>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Power:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Power}"
											   Increment="1"
											   Minimum="0"
											   Maximum="65536" />
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Strength:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Strength}"
											   Increment="1"
											   Minimum="0"
											   Maximum="65536" />
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="IP"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0"
										Margin="4">
								<TextBlock Text="Damage:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.IpDamage}"
											   Increment="1"
											   Minimum="0"
											   Maximum="65536" />
							</StackPanel>
							<StackPanel Grid.Column="1"
										Margin="4">
								<TextBlock Text="Cancel Damage:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.IpCancelDamage}"
											   Increment="1"
											   Minimum="0"
											   Maximum="65536" />
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="Ailments"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0"
										Margin="4">
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.PoisonBitflag}">
									Poison
								</CheckBox>
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.SleepBitflag}">
									Sleep
								</CheckBox>
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.ParalysisBitflag}">
									Paralysis
								</CheckBox>
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.ConfusionBitflag}">
									Confusion
								</CheckBox>
							</StackPanel>
							<StackPanel Grid.Column="1"
										Margin="4">
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.PlagueBitflag}">
									Plague
								</CheckBox>
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.MagicBlockBitflag}">
									Magic Block
								</CheckBox>
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.MoveBlockBitflag}">
									Move Block
								</CheckBox>
								<CheckBox IsThreeState="False"
										  IsChecked="{Binding SelectedItem.Stats.DeathBitflag}">
									Death
								</CheckBox>
							</StackPanel>
						</Grid>
						<StackPanel Margin="4">
							<TextBlock Text="Ailments Chance:" />
							<NumericUpDown Value="{Binding SelectedItem.Stats.AilmentsChance}"
										   Increment="1"
										   Minimum="0"
										   Maximum="100" />
						</StackPanel>
					</StackPanel>
				</StackPanel>
				<StackPanel Grid.Column="2"
							Margin="8">
					<StackPanel Margin="24,14">
						<TextBlock Text="Element Affinity"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Element:" />
								<ComboBox HorizontalAlignment="Stretch"
										  SelectedIndex="{Binding SelectedItem.Stats.Element}"
										  ItemsSource="{locale:Locale Elements}" />
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<TextBlock Text="Element Strength:" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.ElementStrength}"
												   Increment="1"
												   Minimum="0"
												   Maximum="10" />
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="Modifiers"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<StackPanel Margin="4">
									<TextBlock Text="Attack Modifier:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.AttackModifier}"
												   Increment="1"
												   Minimum="-5"
												   Maximum="5" />
								</StackPanel>
								<StackPanel Margin="4">
									<TextBlock Text="Defense Modifier:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.DefenseModifier}"
												   Increment="1"
												   Minimum="-5"
												   Maximum="5" />
								</StackPanel>
							</StackPanel>
							<StackPanel Margin="4"
										Grid.Column="1">
								<StackPanel Margin="4">
									<TextBlock Text="Action Modifier:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.ActionModifier}"
												   Increment="1"
												   Minimum="-5"
												   Maximum="5" />
								</StackPanel>
								<StackPanel Margin="4">
									<TextBlock Text="Movement Modifier:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.MovementModifier}"
												   Increment="1"
												   Minimum="-5"
												   Maximum="5" />
								</StackPanel>
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="Coin Costs"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<StackPanel Margin="4">
									<TextBlock Text="Level 1:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.CoinCost1}"
												   Increment="1"
												   Minimum="0"
												   Maximum="65536" />
								</StackPanel>
								<StackPanel Margin="4">
									<TextBlock Text="Level 3:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.CoinCost3}"
												   Increment="1"
												   Minimum="0"
												   Maximum="65536" />
								</StackPanel>
								<StackPanel Margin="4">
									<TextBlock Text="Level 5:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.CoinCost5}"
												   Increment="1"
												   Minimum="0"
												   Maximum="65536" />
								</StackPanel>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<StackPanel Margin="4">
									<TextBlock Text="Level 2:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.CoinCost2}"
												   Increment="1"
												   Minimum="0"
												   Maximum="65536" />
								</StackPanel>
								<StackPanel Margin="4">
									<TextBlock Text="Level 4:" />
									<NumericUpDown Value="{Binding SelectedItem.Stats.CoinCost4}"
												   Increment="1"
												   Minimum="0"
												   Maximum="65536" />
								</StackPanel>
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="Unknowns"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="4"
										Grid.Column="0">
								<TextBlock Text="Unknown #1" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Unknown1}"
											   Increment="1"
											   Minimum="0"
											   Maximum="256" />
							</StackPanel>
						</Grid>
					</StackPanel>
					<StackPanel Margin="24,14">
						<TextBlock Text="Special"
								   HorizontalAlignment="Center"
								   Classes="h2" />
						<Grid>
							<StackPanel>
								<TextBlock Text="Special" />
								<NumericUpDown Value="{Binding SelectedItem.Stats.Special}"
											   Increment="1"
											   Minimum="0"
											   Maximum="65536" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
