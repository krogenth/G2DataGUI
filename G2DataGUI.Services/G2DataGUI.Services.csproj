<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <BaseOutputPath>..\..\build</BaseOutputPath>
	  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	  <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<WarningLevel>9999</WarningLevel>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\G2DataGUI.Common\G2DataGUI.Common.csproj" />
		<ProjectReference Include="..\G2DataGUI.Contexts\G2DataGUI.Contexts.csproj" />
		<ProjectReference Include="..\G2DataGUI.Export\G2DataGUI.Export.csproj" />
		<ProjectReference Include="..\G2DataGUI.Locale\G2DataGUI.Locale.csproj" />
	</ItemGroup>

</Project>
