<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <BaseOutputPath>..\..\build</BaseOutputPath>
	  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	  <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<WarningLevel>9999</WarningLevel>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<!--
	  Headless on purpose: no Avalonia reference here. This project holds
	  locale *data* (LocaleKeys, LocaleService, the JSON asset) so both
	  Export (CSV, no UI) and UI.Common (the LocaleExtension markup
	  extension) can depend on it without Export ever pulling in Avalonia.
	  Previously Export referenced UI.Common directly just to reuse
	  LocaleService — see PORTING.md, "Known rough edges" — this project
	  is the fix.
	-->
	<ItemGroup>
		<ProjectReference Include="..\G2DataGUI.IO\G2DataGUI.IO.csproj" />
		<ProjectReference Include="..\G2DataGUI.LocaleGenerator\G2DataGUI.LocaleGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="Assets\Locales\*.json" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\Locales\*.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\Locales\*.json" />
	</ItemGroup>

</Project>
